<style>
    .newsletter-{{ section.id }}{
        background-color: {{ section.settings.bg_color }}
    }
  .index-newsletter {
    padding: 60px 40px;
  }
  .index-newsletter-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    background-color: #f3f3f3;
    border-radius: 16px;
  }
  .index-newsletter-content {
    width: 100%;
    display: grid;
    align-items: center;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
    padding: 40px 60px;
  }
  .index-newsletter-l p.title {
    margin: 0 0 10px;
    font-size: 22px;
    line-height: 26px;
    font-weight: 600;
  }
  .index-newsletter-l p.subtitle {
    font-size: 16px;
    line-height: 20px;
    margin: 0;
  }
  .index-email-signup__input-group {
    display: flex;
    flex-direction: column;
  }

  .index-email-signup__input {
    padding: 10px 40px;
    outline: none;
    border: 1px solid #000;
    border-radius: 50px;
    font-size: 18px;
    line-height: 20px;
    text-align: center;
  }

  .index-email-signup__button {
    padding: 10px 40px;
    outline: none;
    border: 1px solid #000;
    border-radius: 50px;
    font-size: 18px;
    line-height: 20px;
    text-align: center;
    margin: 15px 0 0;
    background: #000;
    color: #fff;
    font-weight: 600;
    cursor: pointer;
  }

  .email-signup__message.email-signup__message--success {
    margin: 15px 0 0;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 18px;
    line-height: 20px;
  }

  @media screen and (max-width: 767px) {
    .index-newsletter{
      padding: 30px 15px;
    }
    .index-newsletter-content{
      grid-template-columns: 100%;
      gap: 20px;
      padding: 20px;
      text-align: center;
    }
  }
</style>
<div class="index-newsletter newsletter-{{ section.id }}">
  <div class="index-newsletter-wrapper">
    <div class="index-newsletter-content">
      <div class="index-newsletter-l">
        <p class="title">{{ section.settings.heading }}</p>
        <p class="subtitle">{{ section.settings.subheading }}</p>
      </div>
      <div class="index-newsletter-r">
        {%- form 'customer', class: 'index-email-signup__form' %}
          <div
            class="index-email-signup__input-group"
          >
            <label
              for="EmailInput-{{ section.id }}"
              class="visually-hidden"
            >
              {{ 'blocks.email_signup.label' | t }}
            </label>
            <input
              id="EmailInput-{{ section.id }}"
              class="index-email-signup__input"
              type="email"
              name="contact[email]"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder=""
              required
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="Email-signup__message-error-{{ section.id }}"
              {% elsif form.posted_successfully? %}
                aria-describedby="Email-signup__message-success-{{ section.id }}"
              {% endif %}
            >
            <button
              class="index-email-signup__button"
              aria-label="{{ 'actions.sign_up' | t }}"
            >
              Reserve launch invite
            </button>
          </div>

          {%- if form.errors -%}
            <div
              id="Email-signup__message-error-{{ section.id }}"
              class="email-signup__message email-signup__message--error"
              tabindex="-1"
            >
              <svg
                viewBox="0 0 20 20"
                xmlns="http://www.w3.org/2000/svg"
                focusable="false"
                aria-hidden="true"
                class="icon-error"
              >
                {%- render 'icon', icon: 'error'  -%}
              </svg>
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </div>
          {%- endif -%}

          {%- if form.posted_successfully? -%}
            <div
              id="Email-signup__message-success-{{ section.id }}"
              class="email-signup__message email-signup__message--success"
              tabindex="-1"
            >
              <span class="svg-wrapper icon-success">
                {{ 'icon-checkmark.svg' | inline_asset_content }}
              </span>
              <p class="email-signup__message-text">{{ 'blocks.email_signup.success' | t }}</p>
            </div>
          {%- endif -%}
        {% endform %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Index Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Get An Exclusive Discount!"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "文案"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "版块背景色",
      "default": "#f3f3f3"
    }
  ],
  "presets": [
    {
      "name": "Index Newsletter"
    }
  ]
}
{% endschema %}
