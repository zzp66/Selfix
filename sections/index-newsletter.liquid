<style>
  .newsletter-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
  }
  .index-newsletter {
    padding: 60px 40px;
  }
  .index-newsletter-wrapper {
    max-width: 1440px;
    margin: 0 auto;
  }
  .index-newsletter-content {
    width: 100%;
    display: grid;
    align-items: center;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
    align-items: stretch;
  }
  .index-newsletter-box {
    display: flex;
    flex-direction: column;
    gap: 30px;
    background-color: #f3f3f3;
    padding: 40px;
    border-radius: 16px;
    text-align: center;
  }
  .index-buy-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    background-color: #f3f3f3;
    padding: 40px;
    border-radius: 16px;
    text-align: center;
  }
  .index-buy-content {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .index-buy-img {
    border-radius: 16px;
    overflow: hidden;
    max-width: 180px;
    min-width: 180px;
  }
  .index-newsletter-content .title {
    margin: 0 0 10px;
    font-size: 32px;
    line-height: 40px;
    font-weight: 600;
  }
  .index-newsletter-content .subtitle {
    font-size: 16px;
    line-height: 20px;
    margin: 0;
  }
  .index-email-signup__input-group {
    display: flex;
    flex-direction: column;
  }

  .index-email-signup__input {
    padding: 10px 40px;
    outline: none;
    border: 1px solid #000;
    border-radius: 50px;
    font-size: 15px;
    line-height: 20px;
    text-align: center;
  }

  .index-email-signup__input::placeholder {
    color: #ccc;
  }
  .index-email-signup__button {
    padding: 10px 40px;
    outline: none;
    border: 1px solid #000;
    border-radius: 50px;
    font-size: 18px;
    line-height: 22px;
    text-align: center;
    margin: 15px 0 0;
    background: #000;
    color: #fff;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .email-signup__message.email-signup__message--success {
    margin: 15px 0 0;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 18px;
    line-height: 20px;
  }

  .index-buy-r {
    margin: 25px 0 0;
    display: flex;
    justify-content: center;
  }
  .index-buy-button {
    width: 100%;
    font-size: 18px;
    line-height: 22px;
    font-weight: 600;
    padding: 10px 30px;
    background-color: #000;
    color: #fff;
    border-radius: 50px;
    border: 1px solid transparent;
    transition: all 0.3s ease;
  }
  .index-buy-button:hover {
    background-color: #fff;
    border-color: #000;
    color: #000;
  }
  .index-email-signup__button:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 767px) {
    .index-newsletter {
      padding: 30px 15px;
    }
    .index-newsletter-content {
      grid-template-columns: 100%;
      gap: 20px;
      padding: 0px;
      text-align: center;
    }
    .index-newsletter-content .title {
      font-size: 26px;
      line-height: 30px;
    }
    .index-newsletter-box {
      padding: 40px 20px;
      gap: 20px;
      border-radius: 8px;
    }
    .index-buy-box {
      gap: 15px;
      padding: 40px 20px;
      border-radius: 8px;
    }
    .index-buy-img {
      border-radius: 8px;
      max-width: 135px;
      min-width: 135px;
    }
    .index-email-signup__input {
      font-size: 14px;
    }
  }
</style>
<div class="index-newsletter newsletter-{{ section.id }}">
  <div class="index-newsletter-wrapper">
    <div class="index-newsletter-content">
      <div class="index-newsletter-box">
        <div class="index-newsletter-l">
          <div class="title">{{ section.settings.heading }}</div>
          <div class="subtitle">{{ section.settings.subheading }}</div>
        </div>
        <div class="index-newsletter-r">
          {%- form 'customer', class: 'index-email-signup__form' %}
            <div
              class="index-email-signup__input-group"
            >
              <label
                for="EmailInput-{{ section.id }}"
                class="visually-hidden"
              >
                {{ 'blocks.email_signup.label' | t }}
              </label>
              <input
                id="EmailInput-{{ section.id }}"
                class="index-email-signup__input"
                type="email"
                name="contact[email]"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="Enter your email address"
                required
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="Email-signup__message-error-{{ section.id }}"
                {% elsif form.posted_successfully? %}
                  aria-describedby="Email-signup__message-success-{{ section.id }}"
                {% endif %}
              >
              <button
                class="index-email-signup__button"
                aria-label="{{ 'actions.sign_up' | t }}"
              >
                Reserve launch invite
              </button>
            </div>

            {%- if form.errors -%}
              <div
                id="Email-signup__message-error-{{ section.id }}"
                class="email-signup__message email-signup__message--error"
                tabindex="-1"
              >
                <svg
                  viewBox="0 0 20 20"
                  xmlns="http://www.w3.org/2000/svg"
                  focusable="false"
                  aria-hidden="true"
                  class="icon-error"
                >
                  {%- render 'icon', icon: 'error'  -%}
                </svg>
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </div>
            {%- endif -%}

            {%- if form.posted_successfully? -%}
              <div
                id="Email-signup__message-success-{{ section.id }}"
                class="email-signup__message email-signup__message--success"
                tabindex="-1"
              >
                <span class="svg-wrapper icon-success">
                  {{ 'icon-checkmark.svg' | inline_asset_content }}
                </span>
                <p class="email-signup__message-text">{{ 'blocks.email_signup.success' | t }}</p>
              </div>
            {%- endif -%}
          {% endform %}
        </div>
      </div>
      <div class="index-buy-box">
        <div class="index-buy-content">
          <div class="index-buy-l">
            <div class="title">{{ section.settings.buy_text }}</div>
            {% if section.settings.buy_info != blank %}
              <div class="subtitle">{{ section.settings.buy_info }}</div>
            {% endif %}
          </div>
          <div class="index-buy-r">
            {%- if section.settings.buy_product != blank -%}
              {%- assign buy_product = section.settings.buy_product -%}
              {%- comment -%}获取产品的第一个变体 ID{%- endcomment -%}
              {%- assign variant_id = buy_product.first_available_variant.id -%}

              <a href="/cart/{{ variant_id }}:1" class="index-buy-button"> Pay Now </a>
            {%- endif -%}
          </div>
        </div>
        {% if section.settings.buy_img != blank %}
          <div class="index-buy-img">
            <img src="{{ section.settings.buy_img | image_url: width: master }}" alt="">
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Index Newsletter",
  "settings": [
    {
      "type": "header",
      "content": "邮件订阅相关设置"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "订阅标题",
      "default": "Get An Exclusive Discount!"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "订阅文案"
    },
    {
      "type": "header",
      "content": "预付款相关设置"
    },
    {
      "type": "text",
      "id": "buy_text",
      "label": "预付款标题",
      "default": "Pay $1 now."
    },
    {
      "type": "textarea",
      "id": "buy_info",
      "label": "预付款文案"
    },
    {
      "type": "product",
      "id": "buy_product",
      "label": "产品选择"
    },
    {
      "type": "text",
      "id": "buy_btn_text",
      "label": "购买按钮文案",
      "default": "Pay Now"
    },
    {
      "type": "image_picker",
      "id": "buy_img",
      "label": "图片"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "版块背景色",
      "default": "#f3f3f3"
    }
  ],
  "presets": [
    {
      "name": "Index Newsletter"
    }
  ]
}
{% endschema %}
