{% comment %} 获取产品数据，确保使用 product_picker 选中的对象 {% endcomment %}
{% assign product_1 = section.settings.product_1_handle %}
{% assign product_2 = section.settings.product_2_handle %}

<style>
  .product-column {
    padding: 60px 40px;
    background-color: #f0f0f0;
  }

  .product-column-title {
    max-width: 880px;
    margin: 0 auto;
    margin-bottom: 40px;
  }

  .product-column-title p.title {
    font-size: 48px;
    line-height: 56px;
    font-weight: 600;
    margin: 0 0 20px 0;
  }
  .product-column-title p.subtitle {
    font-size: 20px;
    line-height: 24px;
    margin: 0;
  }
  .product-column-wrapper {
    max-width: 1440px;
    margin: 0 auto;
    background-color: #fff;
    border-radius: 10px;
    padding: 80px 0;
  }

  ul.product-chose,
  ul.product-info {
    max-width: 880px;
    margin: 0 auto;
    display: flex;
    list-style: none;
    padding: 0;
  }

  .product-info-item {
    flex-basis: 50%;
    padding: 0 10px;
  }

  li.product {
    flex-basis: 50%;
  }

  /* ** 核心 Grid 容器：应用于 product-info-list ** */
  /* 修改：增加了 [info-x-4] 的定义 */
  .product-grid-container {
    display: grid;
    grid-template-rows:
      [title] auto
      [info-1-1] auto [info-1-2] auto [info-1-3] auto [info-1-4] auto
      [info-2-1] auto [info-2-2] auto [info-2-3] auto [info-2-4] auto
      [info-3-1] auto [info-3-2] auto [info-3-3] auto [info-3-4] auto
      [info-4-1] auto [info-4-2] auto [info-4-3] auto [info-4-4] auto
      [info-5-1] auto [info-5-2] auto [info-5-3] auto [info-5-4] auto;

    height: 100%;
  }

  .grid-item {
    padding: 20px 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
  }

  .product-title {
    font-size: 26px;
    line-height: 30px;
    font-weight: 600;
    height: 100px;
  }

  .info-icon {
    height: 60px;
    width: auto;
    max-width: 100%;
    margin-bottom: 20px;
  }

  .info_text {
    font-size: 16px;
    line-height: 20px;
  }
  .product-1-swiper .swiper-slide {
    width: 100%;
  }

  .product-1-swiper-thumbs .swiper-slide {
    max-width: 50px;
    cursor: pointer;
  }

  .product-1-swiper-thumbs .swiper-wrapper {
    justify-content: center;
  }

  .product-media-slide {
    display: flex;
    width: 100%;
  }
  @media screen and (max-width: 767px) {
    .product-column {
      padding: 30px 15px;
    }
    .product-column-title p.title {
      font-size: 28px;
      line-height: 34px;
    }
    .product-column-title p.subtitle {
      font-size: 16px;
      line-height: 20px;
    }
    .product-column-title {
      margin: 0 0 20px 0;
    }
    .product-column-wrapper {
      padding: 30px 15px;
    }
    .product-title {
      font-size: 16px;
      line-height: 20px;
    }
    .grid-item {
      padding: 10px 0;
    }
    .info-icon {
      height: 40px;
      margin-bottom: 10px;
    }
  }
</style>

<div class="product-column">
  <div class="product-column-title text-center">
    <p class="title">{{ section.settings.heading }}</p>
    <p class="subtitle">{{ section.settings.subheading }}</p>
  </div>
  <div class="product-column-wrapper">
    <ul class="product-chose">
      <li class="product">
        <div class="column-product-media">
          <div class="swiper product-1-swiper-{{ section.id }}">
            <div class="swiper-wrapper">
              {% for media in product_1.media %}
                {% if media.media_type == 'image' %}
                  <div class="swiper-slide">
                    <div class="product-media-slide">
                      <img src="{{ media | image_url: width: master }}" alt="{{ media.alt | escape }}">
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>

          <div class="swiper product-1-swiper-thumbs product-1-swiper-thumbs-{{ section.id }}">
            <div class="swiper-wrapper">
              {% for media in product_1.media %}
                {% if media.media_type == 'image' %}
                  <div class="swiper-slide">
                    <div class="product-media-slide">
                      <img src="{{ media | image_url: width: master }}" alt="{{ media.alt | escape }}">
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
      </li>

      <li class="product">
        <div class="column-product-media">
          {% for media in product_2.media %}
            {% if media.media_type == 'image' %}
              <div class="product-media-slide">
                <img src="{{ media | image_url: width: 800 }}" alt="{{ media.alt | escape }}">
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </li>
    </ul>

    <ul class="product-info">
      <li class="product-info-item product-1-info">
        <div class="product-info-list product-grid-container" data-product="1">
          {% for block in section.blocks %}
            {% assign row_index = forloop.index %}
            {% if forloop.first %}
              <div class="product-title grid-item" style="grid-row: title;">{{ product_1.title }}</div>
            {% endif %}

            {% comment %} P1 列引用 P1 数据 {% endcomment %}

            <div class="info-1 grid-item" style="grid-row: info-{{ row_index }}-1;">
              {% if block.settings.p1_info_1_img != blank %}
                <img src="{{ block.settings.p1_info_1_img | image_url: width: master }}" alt="" class="info-icon">
              {% endif %}
              <p class="info_text">{{ block.settings.p1_info_1_text }}</p>
            </div>

            <div class="info-2 grid-item" style="grid-row: info-{{ row_index }}-2;">
              {% if block.settings.p1_info_2_img != blank %}
                <img src="{{ block.settings.p1_info_2_img | image_url: width: master }}" alt="" class="info-icon">
              {% endif %}
              <p class="info_text">{{ block.settings.p1_info_2_text }}</p>
            </div>

            <div class="info-3 grid-item" style="grid-row: info-{{ row_index }}-3;">
              {% if block.settings.p1_info_3_img != blank %}
                <img src="{{ block.settings.p1_info_3_img | image_url: width: master }}" alt="" class="info-icon">
              {% endif %}
              <p class="info_text">{{ block.settings.p1_info_3_text }}</p>
            </div>

            {% comment %} 新增第 4 行 {% endcomment %}
            <div class="info-4 grid-item" style="grid-row: info-{{ row_index }}-4;">
              {% if block.settings.p1_info_4_img != blank %}
                <img src="{{ block.settings.p1_info_4_img | image_url: width: master }}" alt="" class="info-icon">
              {% endif %}
              <p class="info_text">{{ block.settings.p1_info_4_text }}</p>
            </div>
          {% endfor %}
        </div>
      </li>

      <li class="product-info-item product-2-info">
        <div class="product-info-list product-grid-container" data-product="2">
          {% for block in section.blocks %}
            {% assign row_index = forloop.index %}
            {% if forloop.first %}
              <div class="product-title grid-item" style="grid-row: title;">{{ product_2.title }}</div>
            {% endif %}

            {% comment %} P2 列引用 P2 数据 {% endcomment %}

            <div class="info-1 grid-item" style="grid-row: info-{{ row_index }}-1;">
              {% if block.settings.p2_info_1_img != blank %}
                <img src="{{ block.settings.p2_info_1_img | image_url: width: master }}" alt="" class="info-icon">
              {% endif %}
              <p class="info_text">{{ block.settings.p2_info_1_text }}</p>
            </div>

            <div class="info-2 grid-item" style="grid-row: info-{{ row_index }}-2;">
              {% if block.settings.p2_info_2_img != blank %}
                <img src="{{ block.settings.p2_info_2_img | image_url: width: master }}" alt="" class="info-icon">
              {% endif %}
              <p class="info_text">{{ block.settings.p2_info_2_text }}</p>
            </div>

            <div class="info-3 grid-item" style="grid-row: info-{{ row_index }}-3;">
              {% if block.settings.p2_info_3_img != blank %}
                <img src="{{ block.settings.p2_info_3_img | image_url: width: master }}" alt="" class="info-icon">
              {% endif %}
              <p class="info_text">{{ block.settings.p2_info_3_text }}</p>
            </div>

            {% comment %} 新增第 4 行 {% endcomment %}
            <div class="info-4 grid-item" style="grid-row: info-{{ row_index }}-4;">
              {% if block.settings.p2_info_4_img != blank %}
                <img src="{{ block.settings.p2_info_4_img | image_url: width: master }}" alt="" class="info-icon">
              {% endif %}
              <p class="info_text">{{ block.settings.p2_info_4_text }}</p>
            </div>
          {% endfor %}
        </div>
      </li>
    </ul>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var thumbsSwiper = new Swiper('.product-1-swiper-thumbs-{{ section.id }}', {
      slidesPerView: 'auto',
      spaceBetween: 15,
    });
    var mySwiper = new Swiper('.product-1-swiper-{{ section.id }}', {
      centeredSlides: true,
      slidesPerView: 'auto',
      spaceBetween: 10,
      loop: true,
      thumbs: {
        swiper: thumbsSwiper,
      },
    });
  });
</script>
{% schema %}
{
  "name": "Product Column",
  "max_blocks": 2,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Snap"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "product",
      "id": "product_1_handle",
      "label": "选择产品 1"
    },
    {
      "type": "product",
      "id": "product_2_handle",
      "label": "选择产品 2"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "参数行 (包含4个数据点)",
      "settings": [
        { "type": "header", "content": "--- Product 1 (左侧) ---" },
        { "type": "image_picker", "id": "p1_info_1_img", "label": "P1 Info 1 Icon" },
        { "type": "textarea", "id": "p1_info_1_text", "label": "P1 Info 1 Text" },

        { "type": "image_picker", "id": "p1_info_2_img", "label": "P1 Info 2 Icon" },
        { "type": "textarea", "id": "p1_info_2_text", "label": "P1 Info 2 Text" },

        { "type": "image_picker", "id": "p1_info_3_img", "label": "P1 Info 3 Icon" },
        { "type": "textarea", "id": "p1_info_3_text", "label": "P1 Info 3 Text" },

        { "type": "image_picker", "id": "p1_info_4_img", "label": "P1 Info 4 Icon" },
        { "type": "textarea", "id": "p1_info_4_text", "label": "P1 Info 4 Text" },

        { "type": "header", "content": "--- Product 2 (右侧) ---" },
        { "type": "image_picker", "id": "p2_info_1_img", "label": "P2 Info 1 Icon" },
        { "type": "textarea", "id": "p2_info_1_text", "label": "P2 Info 1 Text" },

        { "type": "image_picker", "id": "p2_info_2_img", "label": "P2 Info 2 Icon" },
        { "type": "textarea", "id": "p2_info_2_text", "label": "P2 Info 2 Text" },

        { "type": "image_picker", "id": "p2_info_3_img", "label": "P2 Info 3 Icon" },
        { "type": "textarea", "id": "p2_info_3_text", "label": "P2 Info 3 Text" },

        { "type": "image_picker", "id": "p2_info_4_img", "label": "P2 Info 4 Icon" },
        { "type": "textarea", "id": "p2_info_4_text", "label": "P2 Info 4 Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Column"
    }
  ]
}
{% endschema %}
