<style>
  .video-with-grid p {
    margin: 0;
  }
  .video-with-grid {
    background-color: #f5f5f5;
    padding: 80px 40px 120px;
  }
  .video-with-grid-title {
    margin: 0 auto;
    text-align: center;
  }
  .video-with-grid-title .title {
    margin: 0 0 30px 0;
  }
  .video-box video {
    width: 100%;
    height: auto;
  }
  .video-box.mb {
    display: none;
  }
  .feature-grid-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  .feature-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background-color: #fff;
    padding: 20px;
    border-radius: 10px;
  }

  .feature-image-block {
    display: flex;
    border-radius: 10px;
    overflow: hidden;
  }

  .feature-content-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 40px;
  }
  .feature-content-block p.feature-title {
    margin: 0 0 20px 0;
  }
  @media screen and (max-width: 768px) {
    .video-box.pc {
      display: none;
    }
    .video-box.mb {
      display: block;
    }
    .video-with-grid {
      padding: 30px 15px;
    }
    .video-with-grid-title .title {
      margin: 0 0 20px 0;
    }
    .feature-row {
      grid-template-columns: 1fr;
      padding: 10px;
    }
    .feature-content-block {
      padding: 20px;
    }
  }
</style>
<div class="video-with-grid">
  <div class="video-with-grid-title">
    <div class="title title-h1 fw-600">{{ section.settings.heading }}</div>
    {% if section.settings.subheading != blank %}
      <p class="subtitle regular-text">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>
  <div class="text-with-video-wrapper regular-width">
    <div class="text-with-video-content">
      <div class="video-box pc">
        {{
          section.settings.video
          | video_tag: class: 'twv-video', playsinline: true, muted: true, loop: true, autoplay: true
        }}
      </div>
      <div class="video-box mb">
        {{
          section.settings.video_mb
          | video_tag: class: 'twv-video', playsinline: true, muted: true, loop: true, autoplay: true
        }}
      </div>
    </div>
  </div>

  <div class="feature-grid-wrapper regular-width">
    <div class="feature-grid-content">
      {% comment %} 第一行 {% endcomment %}
      <div class="feature-row">
        <div class="feature-image-block">
          <img src="{{ section.settings.row1_img | image_url: width: master }}" alt="">
        </div>
        <div class="feature-content-block">
          <p class="feature-title title-h1 fw-600">{{ section.settings.row1_heading }}</p>
          <p class="regular-text">{{ section.settings.row1_text }}</p>
        </div>
      </div>
      {% comment %} 第二行 {% endcomment %}
      <div class="feature-row">
        <div class="feature-content-block">
          <p class="feature-title title-h1 fw-600">{{ section.settings.row2_heading }}</p>
          <p class="regular-text">{{ section.settings.row2_text }}</p>
        </div>
        <div class="feature-image-block">
          <img src="{{ section.settings.row2_img | image_url: width: master }}" alt="">
        </div>
      </div>

      {% comment %} 第三行 {% endcomment %}
      <div class="feature-row">
        <div class="feature-image-block">
          <img src="{{ section.settings.row3_img | image_url: width: master }}" alt="">
        </div>
        <div class="feature-content-block">
          <p class="feature-title title-h1 fw-600">{{ section.settings.row3_heading }}</p>
          <p class="regular-text">{{ section.settings.row3_text }}</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Video With Grid",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video PC端"
    },
    {
      "type": "video",
      "id": "video_mb",
      "label": "Video 移动端"
    },
    {
      "type": "header",
      "content": "Row 1"
    },
    {
      "type": "image_picker",
      "id": "row1_img",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "row1_heading",
      "label": "Heading",
      "default": "Photograph"
    },
    {
      "type": "textarea",
      "id": "row1_text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Row 2"
    },
    {
      "type": "text",
      "id": "row2_heading",
      "label": "Heading",
      "default": "Placement"
    },
    {
      "type": "textarea",
      "id": "row2_text",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "row2_img",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Row 3"
    },
    {
      "type": "image_picker",
      "id": "row3_img",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "row3_heading",
      "label": "Heading",
      "default": "Portable"
    },
    {
      "type": "textarea",
      "id": "row3_text",
      "label": "Text"
    }
  ],
  "presets": [
    {
      "name": "Video With Grid"
    }
  ]
}
{% endschema %}
