<div class="text-with-video">
  <div class="text-with-video-wrapper">
    <div class="text-with-video-title">
      <p class="title">{{ section.settings.heading }}</p>
      {% if section.settings.subheading != blank %}
        <p class="subtitle">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>
    <div class="text-with-video-content">
      <div class="video-box">
        {{ section.settings.video | video_tag: class: 'twv-video', playsinline: true, muted: true, loop: true }}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Text With Video",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "iPhone Air"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    }
  ],
  "presets": [
    {
      "name": "Text With Video"
    }
  ]
}
{% endschema %}
