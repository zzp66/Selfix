<style>
  .text-with-video-title {
    margin: 0 auto;
    text-align: center;
  }
  .text-with-video-title .title {
    margin: 0 0 20px 0;
  }

  .text-with-video-title p.subtitle {
    margin: 0;
  }
  .video-box video {
    width: 100%;
    height: auto;
  }

  .video-box.mb {
    display: none;
  }
  @media screen and (max-width: 767px) {
    .video-box.pc {
      display: none;
    }
    .video-box.mb {
      display: block;
    }
  }
</style>
<div class="text-with-video regular-padding">
  <div class="text-with-video-title">
    <div class="title title-h1 fw-600">{{ section.settings.heading }}</div>
    {% if section.settings.subheading != blank %}
      <p class="subtitle regular-text">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>
  <div class="text-with-video-wrapper regular-width">
    <div class="text-with-video-content">
      <div class="video-box pc">
        {{
          section.settings.video
          | video_tag: class: 'twv-video', playsinline: true, muted: true, loop: true, autoplay: true
        }}
      </div>
      <div class="video-box mb">
        {{
          section.settings.video_mb
          | video_tag: class: 'twv-video', playsinline: true, muted: true, loop: true, autoplay: true
        }}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Text With Video",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video PC端"
    },
    {
      "type": "video",
      "id": "video_mb",
      "label": "Video 移动端"
    }
  ],
  "presets": [
    {
      "name": "Text With Video"
    }
  ]
}
{% endschema %}
