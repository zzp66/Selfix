<style>
  .selfie-case-hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
    display: flex;
    box-sizing: border-box;
  }

  /* 新增：链接包装器样式 */
  .selfie-case-hero__wrapper {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 100vh;
    padding: 60px;
    text-decoration: none; /* 防止文字出现下划线 */
    color: inherit;
    cursor: default;
  }

  /* 当存在链接时，鼠标指针变为手型 */
  a.selfie-case-hero__wrapper {
    cursor: pointer;
  }

  .selfie-case-hero__image-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    object-fit: cover;
    object-position: center;
  }
  .selfie-case-hero__image--desktop {
    display: block;
  }
  .selfie-case-hero__image--mobile {
    display: none;
  }

  .selfie-case-hero__content {
    position: relative;
    z-index: 10;
  }

  .selfie-case-hero__subtitle {
    font-size: 20px;
    line-height: 24px;
    font-weight: 400;
    margin: 0 0 20px 0;
  }

  .selfie-case-hero__title p {
    margin: 0;
    font-size: 48px;
    line-height: 56px;
    font-weight: 600;
  }

  .selfie-case-hero__bottom-left {
    position: absolute;
    bottom: 60px;
    left: 60px;
    z-index: 10;
    text-align: left;
    font-size: 20px;
    line-height: 24px;
  }

  @media screen and (max-width: 767px) {
    .selfie-case-hero__wrapper {
      padding: 15px 15px 60px;
      align-items: flex-end;
    }
    .selfie-case-hero__subtitle {
      font-size: 16px;
      line-height: 20px;
    }
    .selfie-case-hero__title p {
      font-size: 24px;
      line-height: 32px;
    }
    .selfie-case-hero__bottom-left {
      left: 15px;
      font-size: 16px;
      line-height: 20px;
    }
    .selfie-case-hero__image--desktop {
      display: none;
    }
    .selfie-case-hero__image--mobile {
      display: block;
    }
  }
</style>

<div class="selfie-case-hero">
  {%- assign section_link = section.settings.click_link -%}

  {% comment %} 根据是否有链接判断渲染 a 标签还是 div 标签 {% endcomment %}
  {%- if section_link != blank -%}
    <a href="{{ section_link }}" class="selfie-case-hero__wrapper">
  {%- else -%}
    <div class="selfie-case-hero__wrapper">
  {%- endif -%}

  {% comment %} 图片渲染部分 {% endcomment %}
  {%- if section.settings.image_desktop != blank -%}
    {{
      section.settings.image_desktop
      | image_url: width: 3840
      | image_tag:
        loading: 'lazy',
        class: 'selfie-case-hero__image-wrapper selfie-case-hero__image--desktop',
        sizes: '100vw',
        widths: '750, 1500, 2000, 3000, 3840'
    }}
  {%- endif -%}

  {%- if section.settings.image_mobile != blank -%}
    {{
      section.settings.image_mobile
      | image_url: width: 1500
      | image_tag:
        loading: 'lazy',
        class: 'selfie-case-hero__image-wrapper selfie-case-hero__image--mobile',
        sizes: '100vw',
        widths: '750, 1000, 1500'
    }}
  {%- endif -%}

  {%- unless section.settings.image_desktop != blank or section.settings.image_mobile != blank -%}
    <div class="selfie-case-hero__image-wrapper" style="background-color: #f2f2f2;"></div>
  {%- endunless -%}

  {% comment %} 文案内容 {% endcomment %}
  <div class="selfie-case-hero__content" style="color: {{ section.settings.text_color }}">
    {%- if section.settings.subtitle != blank -%}
      <p class="selfie-case-hero__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <div class="selfie-case-hero__title">{{ section.settings.title }}</div>
    {%- endif -%}
  </div>

  <div class="selfie-case-hero__bottom-left" style="color: {{ section.settings.text_color_bottom_left }}">
    {%- if section.settings.subtitle_bottom_left != blank -%}
      <p class="selfie-case-hero__subtitle">{{ section.settings.subtitle_bottom_left }}</p>
    {%- endif -%}
  </div>

  {%- if section_link != blank -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section-hero-selfie",
  "settings": [
    {
      "type": "header",
      "content": "点击链接设置"
    },
    {
      "type": "url",
      "id": "click_link",
      "label": "横幅跳转链接",
      "info": "配置后，点击图片任何位置均可跳转"
    },
    {
      "type": "header",
      "content": "背景图片设置"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "PC端背景图片"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "移动端背景图片"
    },
    {
      "type": "header",
      "content": "左侧居中文案设置"
    },
    {
      "type": "text",
      "id": "subtitle",
      "default": "Better Selfies, More Space",
      "label": "副标题"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "主标题"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#000000",
      "label": "文案颜色"
    },
    {
      "type": "header",
      "content": "左下角文案设置"
    },
    {
      "type": "text",
      "id": "subtitle_bottom_left",
      "default": "Coming Soon on Kickstarter",
      "label": "左下角文案"
    },
    {
      "type": "color",
      "id": "text_color_bottom_left",
      "default": "#000000",
      "label": "左下角文案颜色"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "category": "Image"
    }
  ]
}
{% endschema %}
