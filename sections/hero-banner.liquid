<style>
  .selfie-case-hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 60px;
    box-sizing: border-box;
  }

  /* 统一的图片样式 */
  .selfie-case-hero__image-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background-position: center;
    background-size: cover; /* 保证图片覆盖容器并自适应 */
  }

  /* PC端默认显示 */
  .selfie-case-hero__image--desktop {
    display: block; /* PC端默认显示 */
  }

  /* 移动端默认隐藏 */
  .selfie-case-hero__image--mobile {
    display: none;
  }

  /* --- 媒体查询：切换到移动端视图 --- */
  @media screen and (max-width: 768px) {
    .selfie-case-hero {
      padding: 30px;
    }
    .selfie-case-hero__title {
      font-size: 32px;
    }

    /* 移动端：隐藏桌面图，显示移动图 */
    .selfie-case-hero__image--desktop {
      display: none;
    }
    .selfie-case-hero__image--mobile {
      display: block;
    }
  }

  /* 文案样式保持不变 */
  .selfie-case-hero__content {
    position: relative;
    z-index: 10;
    color: #000;
  }

  .selfie-case-hero__subtitle {
    font-size: 18px;
    font-weight: 400;
    margin-bottom: 8px;
  }

  .selfie-case-hero__title {
    font-size: 48px;
    font-weight: 600;
    line-height: 1.1;
  }
</style>

<div class="selfie-case-hero">
  {% comment %} 1. PC 端图片 {% endcomment %}
  {%- if section.settings.image_desktop != blank -%}
    {{
      section.settings.image_desktop
      | image_url: width: 3840
      | image_tag:
        loading: 'lazy',
        class: 'selfie-case-hero__image-wrapper selfie-case-hero__image--desktop',
        sizes: '100vw',
        widths: '750, 1500, 2000, 3000, 3840'
    }}
  {%- endif -%}

  {% comment %} 2. 移动端图片 {% endcomment %}
  {%- if section.settings.image_mobile != blank -%}
    {{
      section.settings.image_mobile
      | image_url: width: 1500
      | image_tag:
        loading: 'lazy',
        class: 'selfie-case-hero__image-wrapper selfie-case-hero__image--mobile',
        sizes: '100vw',
        widths: '750, 1000, 1500'
    }}
  {%- endif -%}

  {% comment %} 如果两张图都没设置，则显示占位背景色（可选） {% endcomment %}
  {%- unless section.settings.image_desktop != blank or section.settings.image_mobile != blank -%}
    <div class="selfie-case-hero__image-wrapper" style="background-color: #f2f2f2;"></div>
  {%- endunless -%}

  <div class="selfie-case-hero__content" style="color: {{ section.settings.text_color }}">
    {%- if section.settings.subtitle != blank -%}
      <p class="selfie-case-hero__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h1 class="selfie-case-hero__title">{{ section.settings.title | escape }}</h1>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section-hero-selfie",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "PC端背景图片 (桌面端)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "移动端背景图片 (手机端)"
    },
    {
      "type": "text",
      "id": "subtitle",
      "default": "Better Selfies, More Space",
      "label": "副标题"
    },
    {
      "type": "textarea",
      "id": "title",
      "default": "The Ultimate Selfie Case for iPhone",
      "label": "主标题"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#000000",
      "label": "文案颜色"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "category": "Image"
    }
  ]
}
{% endschema %}
