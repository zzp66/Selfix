<style>
  .section-custom-apple-tabs {
    padding: 60px 40px;
  }
  .product-feature-tabs {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .tab-navigation {
    display: inline-flex;
    position: relative;
    padding: 5px;
    margin: 40px 0 0;
    border-radius: 12px;
    background-color: #f0f0f0;
  }
  .moving-background {
    position: absolute;
    top: 5px;
    left: 5px;
    height: calc(100% - 10px);
    width: 0;
    background-color: #000;
    border-radius: 8px;
    z-index: 1;
    /* 关键：使用 transform 实现平滑、高性能的移动动效 */
    transition: transform 0.35s cubic-bezier(0.25, 0.1, 0.25, 1), width 0.35s cubic-bezier(0.25, 0.1, 0.25, 1);
    pointer-events: none;
  }
  .tab-title {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    cursor: pointer;
    background: none;
    border: none;
    padding: 10px 20px;
    z-index: 2;
    font-size: 16px;
    font-weight: 500;
    min-width: 120px;
    transition: color 0.35s ease;
  }

  .tab-content-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #000;
    transition: color 0.35s ease;
  }
  .tab-icon {
    max-width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tab-icon img {
    max-width: 30px;
    transition: opacity 0.35s ease;
  }

  .tab-icon .normal-icon {
    display: block;
    opacity: 1;
    position: absolute; /* 使两个图标定位在一起 */
  }

  .tab-icon .active-icon {
    display: block;
    opacity: 0;
    position: absolute;
  }

  /* 激活状态：隐藏正常图标，显示激活图标 */
  .tab-title.is-active .tab-icon .normal-icon {
    opacity: 0;
  }

  .tab-title.is-active .tab-icon .active-icon {
    opacity: 1;
  }

  .tab-title.is-active .tab-content-wrapper {
    color: #fff;
  }

  .tab-text {
    margin: 15px 0 0;
  }
  .tab-text p {
    margin: 0;
  }

  .tab-content-container {
    max-width: 600px;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
  }

  .placeholder-content {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    background-color: #f0f0f0;
    min-height: 400px;
    width: 100%;
  }

  .tab-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
  }

  .tab-content.is-active {
    opacity: 1;
    visibility: visible;
  }

  .text-with-tab-text p.title {
    font-size: 48px;
    line-height: 56px;
    font-weight: 600;
    margin: 0 0 20px 0;
  }
  .text-with-tab-text p.subtitle {
    font-size: 20px;
    line-height: 24px;
    margin: 0;
  }

  .text-with-tab-text.text1 {
    margin: 0 auto;
    max-width: 800px;
    margin-bottom: 40px;
  }

  .tab-footer-content-container {
    max-width: 800px;
    margin: 40px auto;
    position: relative;
    min-height: 100px;
  }

  .tab-footer-item {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
  }

  .tab-footer-item.is-active {
    opacity: 1;
    visibility: visible;
  }

  .text-with-tab-text.text2 {
    margin: 0;
    max-width: 100%;
  }

  @media screen and (max-width: 767px) {
    .tab-navigation {
      display: flex;
      overflow: scroll;
    }
    .section-custom-apple-tabs {
      padding: 30px 15px;
    }
    .text-with-tab-text p.title {
      font-size: 28px;
      line-height: 34px;
      margin: 0 0 10px 0;
    }
    .moving-background {
      height: calc(100% - 10px);
    }
    .text-with-tab-text p.subtitle {
      font-size: 16px;
      line-height: 20px;
    }
    .tab-footer-content-container {
      min-height: 80px;
      margin: 30px auto;
    }
    .tab-title {
      padding: 10px;
    }
  }
</style>

<div class="section-custom-apple-tabs">
  <div class="text-with-tab-text text1 text-center">
    <p class="title">{{ section.settings.title_1 }}</p>
    <p class="subtitle">{{ section.settings.text_1 }}</p>
  </div>

  <div class="product-feature-tabs">
    <div class="tab-content-container">
      {% for block in section.blocks %}
        <div
          id="tab-{{ section.id }}-{{ block.id }}"
          class="tab-content {% if forloop.first %}is-active{% endif %}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: master }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              class="tab-image"
            >
          {% else %}
            <div class="placeholder-content">Tab Content Placeholder</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="tab-navigation">
      <div class="moving-background"></div>

      {% for block in section.blocks %}
        {% assign block_title = block.settings.title | default: 'Feature' %}

        <div
          class="tab-title {% if forloop.first %}is-active{% endif %}"
          data-tab-target="#tab-{{ section.id }}-{{ block.id }}"
        >
          <div class="tab-content-wrapper">
            <div class="tab-icon">
              {% if block.settings.icon_image_normal != blank %}
                <img
                  src="{{ block.settings.icon_image_normal | image_url: width: 60 }}"
                  alt="{{ block_title }} icon normal"
                  class="normal-icon"
                >
              {% else %}
                <div class="normal-icon">?</div>
              {% endif %}

              {% if block.settings.icon_image_active != blank %}
                <img
                  src="{{ block.settings.icon_image_active | image_url: width: 60 }}"
                  alt="{{ block_title }} icon active"
                  class="active-icon"
                >
              {% else %}
                <div class="active-icon">!</div>
              {% endif %}
            </div>
            <div class="tab-text">{{ block_title }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="tab-footer-content-container">
    {% for block in section.blocks %}
      <div
        id="text2-{{ section.id }}-{{ block.id }}"
        class="text-with-tab-text text2 text-center tab-footer-item {% if forloop.first %}is-active{% endif %}"
        data-text-id="#tab-{{ section.id }}-{{ block.id }}"
      >
        <p class="title">{{ block.settings.title_content | default: 'Title' }}</p>
        <p class="subtitle">{{ block.settings.text_content | default: 'Subtitle' }}</p>
      </div>
    {% endfor %}
  </div>
</div>

<script>
  (function () {
    const sectionEl = document.getElementById('shopify-section-{{ section.id }}');
    if (!sectionEl) return;

    const tabNav = sectionEl.querySelector('.tab-navigation');
    const tabTitles = tabNav.querySelectorAll('.tab-title');
    const tabContainer = sectionEl.querySelector('.tab-content-container');
    const movingBackground = tabNav.querySelector('.moving-background');
    const initialActiveTab = tabNav.querySelector('.tab-title.is-active');
    const initialActiveContent = tabContainer.querySelector('.tab-content.is-active');
    const footerContainer = sectionEl.querySelector('.tab-footer-content-container');
    const footerItems = sectionEl.querySelectorAll('.tab-footer-item');

    if (!movingBackground || tabTitles.length === 0) return;

    // 从 Schema 获取默认占位符高度，以防无图
    const placeholderMinHeight = 400;

    /**
     * 初始化 Tab 容器的最小高度
     */
    const initializeMinHeight = (contentElement) => {
      const image = contentElement.querySelector('.tab-image');
      const placeholder = contentElement.querySelector('.placeholder-content');

      const setHeight = (height) => {
        tabContainer.style.minHeight = `${Math.max(height, placeholderMinHeight)}px`;
      };

      if (image) {
        if (image.complete) {
          setHeight(image.offsetHeight);
        } else {
          image.onload = () => {
            setHeight(image.offsetHeight);
          };
          setHeight(placeholderMinHeight);
        }
      } else if (placeholder) {
        setHeight(placeholderMinHeight);
      }
    };

    /**
     * 更新移动背景的位置和宽度
     */
    const updateMovingBackground = (activeTab) => {
      const rect = activeTab.getBoundingClientRect();
      const navRect = tabNav.getBoundingClientRect();
      const PADDING_OFFSET = 5;
      const leftPosition = rect.left - navRect.left + tabNav.scrollLeft - PADDING_OFFSET;
      const width = rect.width;

      movingBackground.style.width = `${width}px`;
      movingBackground.style.transform = `translateX(${leftPosition}px)`;
    };

    /**
     * 切换 Tab 的激活状态 (包括图片和底部文本)
     */
    const switchTab = (targetId, clickedTab) => {
      // 1. 移除旧的激活状态 (Tab 标题和图片内容)
      const activeTitle = tabNav.querySelector('.tab-title.is-active');
      const activeContent = tabContainer.querySelector('.tab-content.is-active');

      if (activeTitle) activeTitle.classList.remove('is-active');
      if (activeContent) activeContent.classList.remove('is-active');

      // 2. 移除旧的底部文本激活状态
      const activeFooterItem = footerContainer.querySelector('.tab-footer-item.is-active');
      if (activeFooterItem) activeFooterItem.classList.remove('is-active');

      // 3. 添加新的激活状态 (Tab 标题和图片内容)
      clickedTab.classList.add('is-active');
      const targetContent = sectionEl.querySelector(targetId);
      if (targetContent) {
        targetContent.classList.add('is-active');
      }

      // 4. 添加新的底部文本激活状态 (通过 data-text-id 匹配)
      const targetFooterItem = footerContainer.querySelector(`[data-text-id="${targetId}"]`);
      if (targetFooterItem) {
        targetFooterItem.classList.add('is-active');
      }

      // 5. 移动背景
      updateMovingBackground(clickedTab);
    };

    // --- 页面初始化和事件绑定 ---

    // 1. 初始化：定位移动背景和设置初始最小高度
    if (initialActiveTab) {
      window.requestAnimationFrame(() => updateMovingBackground(initialActiveTab));
    }
    if (initialActiveContent) {
      initializeMinHeight(initialActiveContent);
    }

    // 2. 绑定点击事件
    tabTitles.forEach((tab) => {
      tab.addEventListener('click', (event) => {
        if (tab.classList.contains('is-active')) return;

        // 🚀 修复点: 使用 tab.dataset.tabTarget 正确获取 data-tab-target 属性
        const targetId = tab.dataset.tabTarget;
        switchTab(targetId, tab);
      });
    });

    // 3. 窗口大小变化时重新计算位置和高度
    let resizeTimeout;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        const activeTab = tabNav.querySelector('.tab-title.is-active');
        const activeContent = tabContainer.querySelector('.tab-content.is-active');

        if (activeTab) {
          updateMovingBackground(activeTab);
        }
        if (activeContent) {
          initializeMinHeight(activeContent);
        }
      }, 100);
    });
  })();
</script>

{% schema %}
{
  "name": "Text With Tab",
  "tag": "section",
  "class": "text-with-tab",
  "settings": [
    {
      "type": "text",
      "id": "title_1",
      "label": "顶部标题 (固定)",
      "default": "Your Best Shot, In Any Shot."
    },
    {
      "type": "text",
      "id": "text_1",
      "label": "顶部文案 (固定)",
      "default": "Your Best Shot, In Any Shot."
    }
  ],
  "blocks": [
    {
      "type": "tab_item",
      "name": "Tab 项",
      "settings": [
        {
          "type": "richtext",
          "id": "title",
          "label": "Tab 标题文本"
        },
        {
          "type": "image_picker",
          "id": "icon_image_normal",
          "label": "图标：正常状态",
          "info": "非激活状态下的图标图片"
        },
        {
          "type": "image_picker",
          "id": "icon_image_active",
          "label": "图标：激活状态",
          "info": "激活状态下的图标图片 (通常为白色或深色)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "对应特性图片",
          "info": "图片将实现淡入淡出动效"
        },
        {
          "type": "text",
          "id": "title_content",
          "label": "底部内容标题",
          "default": "Your Best Shot, In Any Shot."
        },
        {
          "type": "textarea",
          "id": "text_content",
          "label": "底部内容副标题",
          "default": "Your Best Shot, In Any Shot."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text With Tab",
      "category": "图像和媒体",
      "blocks": [{ "type": "tab_item" }, { "type": "tab_item" }, { "type": "tab_item" }]
    }
  ]
}
{% endschema %}
