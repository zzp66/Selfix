<style>
  .product-specification {
    background-color: #f0f0f0;
    padding: 60px 40px;
  }
  .product-specification-wrapper {
    max-width: 1440px;
    margin: 0 auto;
  }
  .product-specification-title {
    margin: 0 0 40px 0;
  }
  .product-specification-title p.title {
    font-size: 48px;
    line-height: 56px;
    font-weight: 600;
    margin: 0;
  }
  .product-specification-content {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px 15px;
    align-items: stretch;
  }

  .spec-item {
    background-color: #fff;
    padding: 20px;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .spec-item-icon {
    display: flex;
  }
  .spec-item-info {
    margin: 20px 0 0;
  }
  .spec-item-icon img {
    height: 40px;
    width: auto;
  }
  .spec-item-info p.info-title {
    font-size: 20px;
    line-height: 22px;
    font-weight: 600;
    margin: 0 0 10px 0;
  }
  .spec-item-info p {
    font-size: 16px;
    line-height: 22px;
    margin: 0;
  }

  @media screen and (max-width: 767px) {
    .product-specification {
      padding: 30px 15px;
    }
    .product-specification-title p.title {
      font-size: 28px;
      line-height: 34px;
    }
    .product-specification-content {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .spec-item {
      padding: 10px;
      border-radius: 10px;
    }
    .spec-item-icon img {
      height: 30px;
    }
    .spec-item-info p.info-title {
      font-size: 16px;
      line-height: 20px;
    }
    .spec-item-info p {
      font-size: 14px;
      line-height: 18px;
    }
  }
</style>
<div class="product-specification">
  <div class="product-specification-wrapper">
    <div class="product-specification-title">
      <p class="title">{{ section.settings.heading }}</p>
    </div>
    <div class="product-specification-content">
      {% for item in section.blocks %}
        <div class="spec-item">
          <div class="spec-item-icon">
            <img src="{{ item.settings.icon | image_url: width: master }}" alt="">
          </div>
          <div class="spec-item-info">
            <p class="info-title">{{ item.settings.info_title }}</p>
            <div class="info-text">{{ item.settings.info_text }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Specification",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Specification"
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "info_title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "info_text",
          "label": "Info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Specification"
    }
  ]
}
{% endschema %}
