<style>
  .text-with-image p {
    margin: 0;
  }
  .text-with-image {
    background-color: #fafafc;
    padding: 50px 0 0;
  }
  .text-with-image-title {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  .text-with-image-title p.title {
    margin: 0 0 20px 0;
  }
  .text-with-image-title p.subtitle {
    margin: 0;
  }
  .text-with-image-wrapper {
    margin: 60px 0 0;
  }

  .image-with-swiper-wrapper {
    padding: 60px 0;
  }

  .image-with-swiper .swiper-slide {
    width: 80%;
  }

  .image-with-swiper .swiper-slide {
    /* 添加过渡效果，使缩放更平滑 */
    transition: transform 300ms ease, opacity 300ms ease;
    /* 默认状态：非激活的 Slide 缩小 */
    transform: scale(0.85); /* 将其缩小到 85% */
    opacity: 0.7; /* 可以适当降低透明度，增强未激活的感觉 */
  }

  .image-with-swiper .swiper-slide-active {
    /* 激活状态：保持正常大小 */
    transform: scale(1);
    opacity: 1;
  }

  .iws-pagination {
    position: relative;
    top: auto;
    bottom: auto;
    margin: 40px 0 0;
  }
  .image-with-swiper .swiper-pagination-bullet {
    width: 25px;
    height: 6px;
    background: #000;
    border-radius: 6px;
    opacity: 0.4;
    transition: opacity 0.3s;
  }
  .image-with-swiper .swiper-pagination-bullet-active {
    opacity: 1;
  }

  .image-with-swiper {
    margin: 40px 0 0;
  }
  .iws-slide-img-box {
    position: relative;
  }

  .iws-slide-btn {
    position: absolute;
    top: 7%;
    right: 4%;
    cursor: pointer;
  }

  @keyframes spin-btn {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .iws-slide-btn img {
    max-width: 70px;
    animation: spin-btn 3s linear infinite;
    transform-origin: center center;
  }
  .iws-slide-img {
    margin: 0 0 40px 0;
  }

  .iws-slide-img .image-2 {
    display: none;
  }
  .iws-slide-info {
    margin: 0 auto;
    max-width: 60%;
  }
  p.iws-title {
    font-size: 24px;
    line-height: 28px;
    font-weight: 600;
    margin: 0 0 10px 0;
  }

  @media screen and (max-width: 767px) {
    .text-with-image {
      padding: 30px 15px;
    }
    .text-with-image-wrapper {
      margin: 20px 0 0;
      padding: 0;
    }
    .text-with-image-title {
      max-width: 100%;
    }
    .image-with-swiper-wrapper {
      margin: 20px 0 0;
      padding: 0;
    }
    .image-with-swiper {
      margin: 30px 0 0;
    }
    .iws-slide-info {
      max-width: 100%;
    }
    .iws-slide-btn img {
      max-width: 30px;
    }
    .iws-slide-btn {
      right: 3%;
    }
    .iws-slide-img {
      margin: 0 0 20px 0;
    }
    p.iws-title {
      font-size: 20px;
      line-height: 24px;
    }
    .iws-pagination {
      margin: 20px 0 0;
    }
  }
</style>
<div class="text-with-image">
  <div class="text-with-image-title">
    <p class="title title-h1 fw-600">{{ section.settings.heading }}</p>
    {% if section.settings.subheading != blank %}
      <p class="subtitle regular-text">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>
  <div class="text-with-image-wrapper">
    <div class="text-with-image-content">
      <div class="image-box">
        <picture>
          <source media="(max-width: 768px)" srcset="{{ section.settings.img_mb | image_url: width: master }}">
          <source media="(min-width: 769px)" srcset="{{ section.settings.img_pc | image_url: width: master }}">
          <img src="{{ section.settings.img_pc | image_url: width: master }}">
        </picture>
      </div>
    </div>
  </div>
  <div class="image-with-swiper-wrapper">
    <p class="image-with-swiper-info regular-text text-center fw-600">{{ section.settings.swiper_info }}</p>
    <div class="swiper image-with-swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide">
            <div class="iws-slide">
              <div class="iws-slide-img-box">
                <div class="iws-slide-img">
                  <img class="image-1" src="{{ block.settings.img_1 | image_url: width: master }}" alt="">
                  <img class="image-2" src="{{ block.settings.img_2 | image_url: width: master }}" alt="">
                </div>
                <div class="iws-slide-btn">
                  <img
                    src="https://cdn.shopify.com/s/files/1/0986/4842/4742/files/Toggle_button.svg?v=1764916606"
                    alt=""
                  >
                </div>
              </div>
              <div class="iws-slide-info text-center">
                <p class="iws-title">{{ block.settings.title }}</p>
                <div class="iws-text regular-text">{{ block.settings.text }}</div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
      <div class="swiper-pagination iws-pagination"></div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('.image-with-swiper', {
      initialSlide: 0,
      centeredSlides: true,
      slidesPerView: 1,
      loop: true,
      grabCursor: true,
      pagination: {
        el: '.iws-pagination',
        clickable: true,
      },
      breakpoints: {
        768: {
          slidesPerView: 'auto',
        },
      },
    });

    document.querySelectorAll('.iws-slide-btn').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation(); // 避免触发 Swiper 滑动

        const slide = btn.closest('.swiper-slide');
        const img1 = slide.querySelector('.image-1');
        const img2 = slide.querySelector('.image-2');

        if (img1.style.display === 'none') {
          img1.style.display = 'block';
          img2.style.display = 'none';
        } else {
          img1.style.display = 'none';
          img2.style.display = 'block';
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Text With Image",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "iPhone Air"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "image_picker",
      "id": "img_pc",
      "label": "Image PC端"
    },
    {
      "type": "image_picker",
      "id": "img_mb",
      "label": "Image 移动端"
    },
    {
      "type": "header",
      "content": "轮播相关内容"
    },
    {
      "type": "text",
      "id": "swiper_info",
      "label": "轮播信息"
    }
  ],
  "blocks": [
    {
      "type": "image_slide",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "img_1",
          "label": "Image 1"
        },
        {
          "type": "image_picker",
          "id": "img_2",
          "label": "Image 2"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text With Image"
    }
  ]
}
{% endschema %}
