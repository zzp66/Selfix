<style>
  .text-with-image {
    background-color: #fafafc;
    padding: 50px 0 0;
  }
  .text-with-image-title {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  .text-with-image-title p.title {
    margin: 0 0 20px 0;
  }
  .text-with-image-title p.subtitle {
    margin: 0;
  }
  .text-with-image-wrapper {
    margin: 60px 0 0;
  }
</style>
<div class="text-with-image">
  <div class="text-with-image-title">
    <p class="title title-h1 fw-600">{{ section.settings.heading }}</p>
    {% if section.settings.subheading != blank %}
      <p class="subtitle regular-text">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>
  <div class="text-with-image-wrapper">
    <div class="text-with-image-content">
      <div class="image-box">
        <picture>
          <source media="(max-width: 768px)" srcset="{{ section.settings.img_mb | image_url: width: master }}">
          <source media="(min-width: 769px)" srcset="{{ section.settings.img_pc | image_url: width: master }}">
          <img src="{{ section.settings.img_pc | image_url: width: master }}">
        </picture>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Text With Image",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "iPhone Air"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "image_picker",
      "id": "img_pc",
      "label": "Image PC端"
    },
    {
      "type": "image_picker",
      "id": "img_mb",
      "label": "Image 移动端"
    }
  ],
  "presets": [
    {
      "name": "Text With Image"
    }
  ]
}
{% endschema %}
