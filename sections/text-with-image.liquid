<style>
  /* 移除：@keyframes spin-btn */

  .text-with-image p {
    margin: 0;
  }
  .text-with-image {
    background-color: #fafafc;
    padding: 50px 0 0;
  }
  .text-with-image-title {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  .text-with-image-title .title {
    margin: 0 0 20px 0;
  }
  .text-with-image-title p.subtitle {
    margin: 0;
  }
  .text-with-image-wrapper {
    margin: 60px 0 0;
  }

  .image-with-swiper-wrapper {
    padding: 60px 0;
  }

  .image-with-swiper .swiper-slide {
    width: 80%;
    opacity: 0.6;
  }

  .image-with-swiper .swiper-slide.swiper-slide-active {
    opacity: 1;
  }

  .image-with-swiper .iws-pagination {
    bottom: 11%;
  }
  .image-with-swiper .swiper-pagination-bullet {
    width: 25px;
    height: 6px;
    background: #000;
    border-radius: 6px;
    opacity: 0.4;
    transition: opacity 0.3s;
  }
  .image-with-swiper .swiper-pagination-bullet-active {
    opacity: 1;
    width: 50px;
  }

  .image-with-swiper {
    margin: 40px 0 0;
  }
  .iws-slide-img-box {
    position: relative;
    margin: 0 0 40px 0;
  }

  .iws-slide-img {
    position: relative;
  }

  /* 图片通用样式 */
  .iws-slide-img img {
    width: 100%;
    height: auto;
    display: block;
  }

  .iws-slide-btn {
    position: absolute;
    top: 7%;
    right: 4%;
    cursor: pointer;
    z-index: 2; /* 确保按钮在图片之上 */
  }

  /* --- 优化部分 (纯缩放) --- */
  .iws-slide-btn img {
    max-width: 65px;
    min-width: 65px;
    transform-origin: center center;
    /* 定义平滑过渡效果，时间缩短至 0.2s */
    transition: transform 0.2s ease-out, opacity 0.2s ease-out;
    transform: scale(1); /* 初始状态 */
    opacity: 1;
  }

  /* 按钮点击时的瞬时动效（纯缩放反馈）*/
  .iws-slide-btn img.active {
    transform: scale(0.85); /* 瞬间缩小到 85% */
    opacity: 0.8;
  }
  /* --- 优化部分结束 --- */

  /* 状态控制 */
  .state-wrapper-1 {
    display: block; /* 默认显示状态1 */
  }
  .state-wrapper-2 {
    display: none; /* 默认隐藏状态2 */
  }

  .iws-slide-info {
    margin: 0 auto;
    max-width: 60%;
  }
  p.iws-title {
    font-size: 24px;
    line-height: 28px;
    font-weight: 600;
    margin: 0 0 10px 0;
  }

  .iws-btns .iws-next,
  .iws-btns .iws-prev {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 45px;
    height: 45px;
    border-radius: 45px;
    background-color: #000;
    color: #fff;
  }
  .iws-btns .iws-next::after,
  .iws-btns .iws-prev::after {
    font-size: 16px;
  }

  @media screen and (min-width: 768px) and (max-width: 1600px) {
    .image-with-swiper .iws-pagination {
      bottom: 18%;
    }
  }

  @media screen and (max-width: 767px) {
    .text-with-image {
      padding: 30px 15px;
    }
    .text-with-image-wrapper {
      margin: 20px 0 0;
      padding: 0;
    }
    .text-with-image-title {
      max-width: 100%;
    }
    .image-with-swiper-wrapper {
      margin: 20px 0 0;
      padding: 0;
    }
    .image-with-swiper {
      margin: 30px 0 0;
    }
    .iws-slide-info {
      max-width: 100%;
    }
    .iws-slide-btn img {
      max-width: 50px;
      min-width: 50px;
    }
    .iws-slide-btn {
      top: auto;
      right: auto;
      bottom: 4%;
      right: 6%;
    }
    .iws-slide-img-box {
      margin: 0 0 20px 0;
    }
    p.iws-title {
      font-size: 20px;
      line-height: 24px;
    }

    .image-with-swiper .iws-pagination {
      position: relative;
      top: auto;
      bottom: auto;
      margin: 20px 0 0;
    }

    .iws-btns {
      width: 100%;
    }
  }
</style>

<div class="text-with-image">
  <div class="text-with-image-title">
    <div class="title title-h1 fw-600">{{ section.settings.heading }}</div>
    {% if section.settings.subheading != blank %}
      <p class="subtitle regular-text">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>
  <div class="text-with-image-wrapper">
    <div class="text-with-image-content">
      <div class="image-box">
        <picture>
          <source media="(max-width: 767px)" srcset="{{ section.settings.img_mb | image_url: width: master }}">
          <source media="(min-width: 768px)" srcset="{{ section.settings.img_pc | image_url: width: master }}">
          <img src="{{ section.settings.img_pc | image_url: width: master }}" style="width:100%; height:auto;">
        </picture>
      </div>
    </div>
  </div>
  <div class="image-with-swiper-wrapper">
    <p class="image-with-swiper-info regular-text text-center fw-600">{{ section.settings.swiper_info }}</p>
    <div class="swiper image-with-swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide">
            <div class="iws-slide">
              <div class="iws-slide-img-box">
                <div class="iws-slide-img">
                  <div class="state-wrapper state-wrapper-1">
                    <picture>
                      {% if block.settings.img_1_mb != blank %}
                        <source
                          media="(max-width: 767px)"
                          srcset="{{ block.settings.img_1_mb | image_url: width: master }}"
                        >
                      {% endif %}
                      <img
                        src="{{ block.settings.img_1_pc | image_url: width: master }}"
                        alt="{{ block.settings.title }}"
                      >
                    </picture>
                  </div>

                  <div class="state-wrapper state-wrapper-2">
                    <picture>
                      {% if block.settings.img_2_mb != blank %}
                        <source
                          media="(max-width: 767px)"
                          srcset="{{ block.settings.img_2_mb | image_url: width: master }}"
                        >
                      {% endif %}
                      <img
                        src="{{ block.settings.img_2_pc | image_url: width: master }}"
                        alt="{{ block.settings.title }}"
                      >
                    </picture>
                  </div>
                </div>
                <div class="iws-slide-btn">
                  <img
                    src="https://cdn.shopify.com/s/files/1/0986/4842/4742/files/Toggle_button.svg?v=1764916606"
                    alt="Toggle"
                  >
                </div>
              </div>
              <div class="iws-slide-info text-center">
                <p class="iws-title">{{ block.settings.title }}</p>
                <div class="iws-text regular-text">{{ block.settings.text }}</div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
      <div class="swiper-pagination iws-pagination"></div>
      <div class="iws-btns">
        <div class="swiper-button-prev iws-prev"></div>
        <div class="swiper-button-next iws-next"></div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const swiper = new Swiper('.image-with-swiper', {
      initialSlide: 1,
      centeredSlides: true,
      slidesPerView: 1,
      spaceBetween: 40,
      grabCursor: true,
      rewind: true,
      pagination: {
        el: '.iws-pagination',
        clickable: true,
      },
      // 如果需要前进后退按钮
      navigation: {
        nextEl: '.iws-next',
        prevEl: '.iws-prev',
      },
      breakpoints: {
        768: {
          slidesPerView: 'auto',
        },
      },
    });

    // 追踪自动切换和延迟恢复的 ID
    let autoToggleIntervalId;
    let resumeTimeoutId;
    const AUTO_SWITCH_INTERVAL = 2000; // 2 秒自动切换
    const RESUME_DELAY = 3000; // 3 秒后恢复自动切换
    const ANIMATION_DURATION = 200; // 对应 CSS 中 0.2s 的过渡时间

    // 封装图片切换逻辑
    function toggleImageState(slide) {
      const wrapper1 = slide.querySelector('.state-wrapper-1');
      const wrapper2 = slide.querySelector('.state-wrapper-2');

      const style1 = window.getComputedStyle(wrapper1).display;

      if (style1 === 'none') {
        wrapper1.style.display = 'block';
        wrapper2.style.display = 'none';
      } else {
        wrapper1.style.display = 'none';
        wrapper2.style.display = 'block';
      }
    }

    // 封装按钮动效逻辑
    function triggerButtonAnimation(btnImage) {
      btnImage.classList.add('active'); // 触发缩小
      setTimeout(() => {
        btnImage.classList.remove('active'); // 恢复原状
      }, ANIMATION_DURATION);
    }

    // 自动切换所有 Slide 的图片状态 (新增按钮动效)
    const autoToggleSlides = document.querySelectorAll('.image-with-swiper .swiper-slide');

    function autoToggleImages() {
      autoToggleSlides.forEach((slide) => {
        const btnImage = slide.querySelector('.iws-slide-btn img');

        // 1. 触发按钮动效
        if (btnImage) {
          triggerButtonAnimation(btnImage);
        }

        // 2. 切换图片
        toggleImageState(slide);
      });
    }

    // 启动自动切换
    function startAutoToggle() {
      if (!autoToggleIntervalId) {
        autoToggleIntervalId = setInterval(autoToggleImages, AUTO_SWITCH_INTERVAL);
      }
    }

    // 停止自动切换，并清除所有待处理的延迟恢复计时器
    function stopAutoToggle() {
      clearInterval(autoToggleIntervalId);
      autoToggleIntervalId = null;
      clearTimeout(resumeTimeoutId);
    }

    // 1. 手动切换功能：点击时停止自动切换，并延迟 3 秒后恢复
    document.querySelectorAll('.iws-slide-btn').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        const slide = btn.closest('.swiper-slide');
        const btnImage = btn.querySelector('img');

        // 1. 停止自动切换
        stopAutoToggle();

        // 2. 触发动效：使用封装函数
        triggerButtonAnimation(btnImage);

        // 3. 执行图片切换
        toggleImageState(slide);

        // 4. 延迟恢复自动切换（注意：这里必须在动画恢复后启动计时器，所以放在 triggerButtonAnimation 内部的 setTimeout 之后）
        // 我们将恢复逻辑移到 triggerButtonAnimation 之后的 setTimeout 块中，以确保它不会覆盖按钮的恢复动画。
        // 由于 triggerButtonAnimation 内部已经有一个 200ms 的 setTimeout，我们直接在外部等待 200ms 后启动 RESUME_DELAY 计时器。
        setTimeout(function () {
          resumeTimeoutId = setTimeout(startAutoToggle, RESUME_DELAY);
        }, ANIMATION_DURATION);
      });
    });

    // 2. 初始化时启动自动切换
    startAutoToggle();

    // 3. 悬停暂停/恢复功能（防止干扰）
    const swiperContainer = document.querySelector('.image-with-swiper');

    swiperContainer.addEventListener('mouseenter', stopAutoToggle);

    swiperContainer.addEventListener('mouseleave', startAutoToggle);
  });
</script>

{% schema %}
{
  "name": "Text With Image",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "image_picker",
      "id": "img_pc",
      "label": "主图 PC端"
    },
    {
      "type": "image_picker",
      "id": "img_mb",
      "label": "主图 移动端"
    },
    {
      "type": "header",
      "content": "轮播相关内容"
    },
    {
      "type": "text",
      "id": "swiper_info",
      "label": "轮播信息"
    }
  ],
  "blocks": [
    {
      "type": "image_slide",
      "name": "Image Block",
      "settings": [
        {
          "type": "header",
          "content": "状态 1 (默认显示)"
        },
        {
          "type": "image_picker",
          "id": "img_1_pc",
          "label": "图片 1 - PC端"
        },
        {
          "type": "image_picker",
          "id": "img_1_mb",
          "label": "图片 1 - 移动端"
        },
        {
          "type": "header",
          "content": "状态 2 (切换后显示)"
        },
        {
          "type": "image_picker",
          "id": "img_2_pc",
          "label": "图片 2 - PC端"
        },
        {
          "type": "image_picker",
          "id": "img_2_mb",
          "label": "图片 2 - 移动端"
        },
        {
          "type": "header",
          "content": "文本内容"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text With Image"
    }
  ]
}
{% endschema %}
